# Telegram booking settings (server only)
# Create a bot with @BotFather and add it to your booking group.
# Set these variables locally in .env and in Vercel Environment Variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BRAND_NAME=ZiyaraTour

# Existing deployments may keep their old VITE_TELEGRAM_* settings temporarily.
# The server accepts them, but the browser never reads or bundles the token.

# Optional SSH deployment connection details (copy into .env.local).
# These are connection settings only; no automatic deployment is configured.
# Keep private keys outside the repository. Use their LOCAL absolute file path.
DEPLOY_SSH_HOST=uz03.ahost.uz
DEPLOY_SSH_USER=ziyarato
# Confirm the SSH port with Ahost (2083 is the cPanel web port).
DEPLOY_SSH_PORT=
DEPLOY_SSH_KEY_PATH=
# Confirm the domain document root in cPanel before uploading.
DEPLOY_REMOTE_DIR=
