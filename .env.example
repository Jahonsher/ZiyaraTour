# Telegram booking settings (server only)
# Create a bot with @BotFather and add it to your booking group.
# Set these variables locally in .env and in Vercel Environment Variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BRAND_NAME=ZiyaraTour

# Existing deployments may keep their old VITE_TELEGRAM_* settings temporarily.
# The server accepts them, but the browser never reads or bundles the token.
