# Telegram bot integration (frontend-only)
# --------------------------------------------------------------
# 1) Yangi bot yarating: https://t.me/BotFather -> /newbot -> tokenni oling
# 2) Guruh yarating va botni admin qilib qo'shing (yozish huquqi bilan)
# 3) Guruh chat_id ni bilish uchun: botni guruhga qo'shgandan keyin
#    https://api.telegram.org/bot<TOKEN>/getUpdates ochib chiqing
#    yoki @userinfobot / @RawDataBot dan foydalaning
# --------------------------------------------------------------

# Botning API tokeni (masalan: 1234567890:AAExxxxxxxxx)
VITE_TELEGRAM_BOT_TOKEN=

# Guruh yoki kanal chat_id (masalan: -1001234567890)
VITE_TELEGRAM_CHAT_ID=

# Ixtiyoriy: kompaniya nomi (xabarlar boshida ko'rinadi)
VITE_BRAND_NAME=ZiyaraTour
